{
  "ruleset_id": "vkr-rule-engine-test",
  "ruleset_version": "2.0.0",
  "description": "Тестовый набор ВКР: текст, поля страницы, заголовки, обязательные разделы и оглавление",
  "rules": [
    {
      "rule_id": "font_body_text",
      "kind": "font",
      "severity": "error",
      "message": "Основной текст набирается гарнитурой Times New Roman, 14 pt",
      "requirement_ref": "Методические указания, требования к оформлению текста",
      "target": {
        "scope": "body_text"
      },
      "expected": {
        "family": "Times New Roman",
        "size_pt": 14.0,
        "size_tolerance_pt": 0.5
      }
    },
    {
      "rule_id": "indent_first_line",
      "kind": "indent",
      "severity": "error",
      "message": "Абзац основного текста начинается с отступа 12,5 мм",
      "requirement_ref": "Методические указания, требования к абзацам",
      "target": {
        "scope": "body_text"
      },
      "expected": {
        "first_line_mm": 12.5,
        "tolerance_mm": 0.5
      }
    },
    {
      "rule_id": "page_margins",
      "kind": "margin",
      "severity": "error",
      "message": "Поля страницы: левое 30, правое 15, верхнее и нижнее 20 мм",
      "requirement_ref": "Методические указания, требования к полям страницы",
      "target": {
        "scope": "sections"
      },
      "expected": {
        "left_mm": 30.0,
        "right_mm": 15.0,
        "top_mm": 20.0,
        "bottom_mm": 20.0,
        "tolerance_mm": 1.0
      }
    },
    {
      "rule_id": "heading_levels",
      "kind": "heading_levels",
      "severity": "error",
      "message": "Заголовки образуют непрерывную иерархию: старт с уровня 1, без перескоков уровней",
      "requirement_ref": "Методические указания, требования к заголовкам",
      "target": {
        "scope": "headings",
        "exclude_roles": ["title_page", "task_sheet", "appendix"]
      },
      "expected": {
        "first_level": 1,
        "allow_skipped_levels": false,
        "max_level": 3
      }
    },
    {
      "rule_id": "heading_numbering",
      "kind": "heading_numbering",
      "severity": "error",
      "message": "Разделы нумеруются последовательно, подраздел начинается с номера родительского раздела",
      "requirement_ref": "Методические указания, требования к нумерации разделов",
      "target": {
        "scope": "headings",
        "exclude_roles": ["title_page", "task_sheet", "appendix"]
      },
      "expected": {
        "check_sequence": true,
        "check_parent_number": true,
        "check_depth_matches_level": true,
        "number_ending": "any",
        "require_number_for_roles": ["main_chapter", "sub_section"]
      }
    },
    {
      "rule_id": "heading_format_text",
      "kind": "heading_format",
      "severity": "error",
      "message": "Заголовок набирается с прописной буквы и без точки в конце",
      "requirement_ref": "Методические указания, требования к оформлению заголовков",
      "target": {
        "scope": "headings",
        "exclude_roles": ["title_page", "task_sheet", "appendix"]
      },
      "expected": {
        "trailing_dot": "forbid"
      }
    },
    {
      "rule_id": "heading_alignment",
      "kind": "heading_format",
      "severity": "warning",
      "message": "Заголовки выравниваются по центру",
      "requirement_ref": "Методические указания, требования к оформлению заголовков",
      "target": {
        "scope": "headings",
        "exclude_roles": ["title_page", "task_sheet", "appendix"]
      },
      "expected": {
        "alignment": "center"
      }
    },
    {
      "rule_id": "required_sections",
      "kind": "required_sections",
      "severity": "error",
      "message": "Документ содержит введение, разделы, заключение и список литературы в требуемом порядке",
      "requirement_ref": "Методические указания, требования к структуре работы",
      "target": {
        "scope": "document_structure",
        "exclude_roles": ["title_page", "task_sheet"]
      },
      "expected": {
        "sections": [
          {
            "label": "введение",
            "role": "introduction",
            "titles": ["ВВЕДЕНИЕ"],
            "required": true
          },
          {
            "label": "основные разделы",
            "role": "main_chapter",
            "required": true
          },
          {
            "label": "заключение",
            "role": "conclusion",
            "titles": ["ЗАКЛЮЧЕНИЕ"],
            "required": true
          },
          {
            "label": "список литературы",
            "role": "bibliography",
            "required": true
          },
          {
            "label": "приложения",
            "role": "appendix",
            "titles": ["ПРИЛОЖЕНИЕ", "ПРИЛОЖЕНИЯ"],
            "required": false
          }
        ]
      }
    },
    {
      "rule_id": "toc",
      "kind": "toc",
      "severity": "error",
      "message": "Оглавление перечисляет все разделы и подразделы и указывает номера страниц",
      "requirement_ref": "Методические указания, требования к оглавлению",
      "target": {
        "scope": "toc"
      },
      "expected": {
        "require_toc": true,
        "require_automated": false,
        "require_page_numbers": true,
        "check_page_numbers": false,
        "check_titles": true,
        "require_dot_leader": false,
        "check_completeness": true,
        "required_entries": [
          {
            "label": "введение",
            "role": "introduction",
            "titles": ["ВВЕДЕНИЕ"]
          },
          {
            "label": "раздел",
            "role": "main_chapter"
          },
          {
            "label": "подраздел",
            "role": "sub_section"
          },
          {
            "label": "заключение",
            "role": "conclusion",
            "titles": ["ЗАКЛЮЧЕНИЕ"]
          },
          {
            "label": "список литературы",
            "role": "bibliography"
          }
        ]
      }
    }
  ]
}
