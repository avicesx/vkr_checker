{
  "openapi": "3.1.0",
  "info": {
    "title": "API нормоконтроля ВКР",
    "description": "Загрузка ВКР и методички для создания проверки. Текущая версия сохраняет файлы и возвращает начальный статус uploaded.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/checks": {
      "post": {
        "tags": [
          "Проверки"
        ],
        "summary": "Загрузить ВКР и методичку",
        "description": "проверяет и сохраняет файлы, затем возвращает ID новой проверки",
        "operationId": "create_check_api_v1_checks_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_check_api_v1_checks_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Пустой файл",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Размер файла превышает 20 МиБ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Неподдерживаемый или некорректный файл",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/checks/{check_id}": {
      "get": {
        "tags": [
          "Проверки"
        ],
        "summary": "Получить статус проверки",
        "description": "возвращает сохранённый статус проверки по её ID",
        "operationId": "get_check_status_api_v1_checks__check_id__get",
        "parameters": [
          {
            "name": "check_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Check Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "404": {
            "description": "Проверка не найдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_create_check_api_v1_checks_post": {
        "properties": {
          "thesis": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Thesis",
            "description": "ВКР в формате DOCX; не более 20 МиБ"
          },
          "guidelines": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Guidelines",
            "description": "Методичка в формате DOCX или PDF; не более 20 МиБ"
          }
        },
        "type": "object",
        "required": [
          "thesis",
          "guidelines"
        ],
        "title": "Body_create_check_api_v1_checks_post"
      },
      "CheckResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Уникальный идентификатор проверки"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus",
            "description": "Текущее состояние. После загрузки задаётся uploaded; значения queued, processing, completed и failed предназначены для фоновой обработки."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Время создания проверки в UTC"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "title": "CheckResponse",
        "description": "данные проверки и её текущий статус",
        "examples": [
          {
            "created_at": "2026-11-06T07:00:00Z",
            "id": "c1be2bc2-3f3a-42b6-b7ca-33bd47011af0",
            "status": "uploaded"
          }
        ]
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "uploaded",
          "queued",
          "processing",
          "completed",
          "failed"
        ],
        "title": "CheckStatus",
        "description": "состояния проверки, доступные через API статуса"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Текстовое описание ошибки"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "описание ошибки, возвращаемой эндпоинтом"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
