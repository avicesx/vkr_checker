{
  "openapi": "3.1.0",
  "info": {
    "title": "VKR Norm Control API",
    "description": "Upload a thesis and its formatting guide to create a check. This version stores uploads and exposes the initial uploaded status.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/checks": {
      "post": {
        "tags": [
          "checks"
        ],
        "summary": "Upload thesis and formatting guide",
        "description": "Validate and save uploaded files, then return the new check ID.",
        "operationId": "create_check_api_v1_checks_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_check_api_v1_checks_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Empty file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File exceeds 20 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported or invalid file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/checks/{check_id}": {
      "get": {
        "tags": [
          "checks"
        ],
        "summary": "Get check status",
        "description": "Return the current persisted status for a check ID.",
        "operationId": "get_check_status_api_v1_checks__check_id__get",
        "parameters": [
          {
            "name": "check_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Check Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "404": {
            "description": "Check not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_create_check_api_v1_checks_post": {
        "properties": {
          "thesis": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Thesis",
            "description": "Thesis document in DOCX format; maximum 20 MiB"
          },
          "guidelines": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Guidelines",
            "description": "Formatting guide in DOCX or PDF format; maximum 20 MiB"
          }
        },
        "type": "object",
        "required": [
          "thesis",
          "guidelines"
        ],
        "title": "Body_create_check_api_v1_checks_post"
      },
      "CheckResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique identifier of the check"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus",
            "description": "Current lifecycle state. Uploads start as uploaded; queued, processing, completed, and failed are reserved for async processing."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "UTC time when the check was created"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "title": "CheckResponse",
        "description": "Public representation of a check and its current status.",
        "examples": [
          {
            "created_at": "2026-11-06T07:00:00Z",
            "id": "c1be2bc2-3f3a-42b6-b7ca-33bd47011af0",
            "status": "uploaded"
          }
        ]
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "uploaded",
          "queued",
          "processing",
          "completed",
          "failed"
        ],
        "title": "CheckStatus",
        "description": "Lifecycle states exposed by the check status API."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human-readable explanation of the error"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Error response returned by API endpoints."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
